{
  "$schema": "https://static.modelcontextprotocol.io/schemas/2025-07-09/server.schema.json",
  "name": "io.github.democratize-technology/vikunja-mcp",
  "description": "Model Context Protocol server for Vikunja task management",
  "status": "active",
  "repository": {
    "url": "https://github.com/willgriffin/vikunja-mcp",
    "source": "github"
  },
  "version": "1.0.0",
  "packages": [
    {
      "registry_type": "npm",
      "registry_base_url": "https://registry.npmjs.org",
      "identifier": "vikunja-mcp",
      "version": "1.0.4",
      "transport": {
        "type": "stdio"
      },
      "environment_variables": [
        {
          "description": "Your API key for the service",
          "is_required": true,
          "format": "string",
          "is_secret": true,
          "name": "YOUR_API_KEY"
        }
      ]
    },
    {
      "registry_type": "oci",
      "registry_base_url": "https://ghcr.io",
      "identifier": "willgriffin/vikunja-mcp",
      "version": "latest",
      "transport": {
        "type": "streamable-http",
        "url": "http://localhost:3333/mcp"
      },
      "environment_variables": [
        {
          "description": "Vikunja API base URL ending in /api/v1",
          "is_required": true,
          "format": "uri",
          "is_secret": false,
          "name": "VIKUNJA_URL"
        },
        {
          "description": "Secret used to encrypt linked per-user Vikunja API tokens",
          "is_required": true,
          "format": "string",
          "is_secret": true,
          "name": "TOKEN_ENCRYPTION_KEY"
        },
        {
          "description": "Shared ContextForge identity-claims signing secret",
          "is_required": true,
          "format": "string",
          "is_secret": true,
          "name": "IDENTITY_CLAIMS_SECRET"
        }
      ]
    }
  ]
}
